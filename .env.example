# ─────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobplatform?schema=public"

# ─────────────────────────────────────────────────────────────────────────
# Auth (NextAuth)
# Generate a secret with: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────
# App mode
# "demo"       -> seeded fictional job listings only (clearly labeled),
#                 safe to run with zero external accounts.
# "production" -> real job sources are used (see below). Falls back to demo
#                 sources automatically for any source without valid credentials.
# ─────────────────────────────────────────────────────────────────────────
APP_MODE="demo"

# ─────────────────────────────────────────────────────────────────────────
# File storage for uploaded CVs.
# "local" stores files under ./storage/uploads (dev only).
# "s3" uses an S3-compatible bucket — set the credentials below.
# ─────────────────────────────────────────────────────────────────────────
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─────────────────────────────────────────────────────────────────────────
# Real job source connectors (all optional — the platform runs on demo data
# when these are absent). Each is a real public/partner API; none are
# scraped or accessed in violation of their terms of service.
# ─────────────────────────────────────────────────────────────────────────

# France Travail (ex Pôle Emploi) "Offres d'emploi" API.
# Register an application at https://pole-emploi.io to obtain these.
FRANCE_TRAVAIL_CLIENT_ID=""
FRANCE_TRAVAIL_CLIENT_SECRET=""

# Adzuna Jobs API (https://developer.adzuna.com/)
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# ─────────────────────────────────────────────────────────────────────────
# Geocoding (used to turn "city" text into lat/lng for distance filtering).
# Uses the free BAN (Base Adresse Nationale) API by default, which needs no
# key. Leave blank to keep using it.
# ─────────────────────────────────────────────────────────────────────────
GEOCODING_PROVIDER="ban"

# ─────────────────────────────────────────────────────────────────────────
# Cron/refresh secret — protects the ingestion + alert-check endpoints from
# being triggered by anyone but your scheduler.
# ─────────────────────────────────────────────────────────────────────────
CRON_SECRET="replace-with-a-random-secret"
